# Copy to a local ignored env file or set in shell; NEVER commit real values.
# This key is consumed ONLY by FastAPI on the server.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
TASKFLOW_DEV_CORS=false
PORT=8080
TASKFLOW_SIGNING_KEY=

# Local Next.js development ONLY, safe non-secret value:
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Production must use same-origin /api (leave empty).
